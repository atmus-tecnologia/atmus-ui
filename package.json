{
  "name": "atmus-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve atmus-ui",
    "build": "ng build atmus-ui",
    "watch": "ng build atmus-ui --watch --configuration development",
    "test": "ng test atmus-ui",
    "build:ngui": "ng build ngui && node projects/ngui/build-styles.mjs",
    "watch:ngui": "ng build ngui --watch",
    "test:ngui": "ng test ngui",
    "pack:ngui": "cd dist/ngui && npm pack --dry-run",
    "publish:ngui": "cd dist/ngui && npm publish --access public"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@atmus/icons": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2"
  }
}
